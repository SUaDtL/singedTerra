    prefab: {fileID: 6933552084964206981, guid: 44013e99ae9a147408cf50fd0211220e, type: 3}
  - id: STK-G03
    title: Twin autocannon
    category: Gun
    mount: gun-breech
    description: Paired barrels and ammunition boxes; visual candidate, no rate or
