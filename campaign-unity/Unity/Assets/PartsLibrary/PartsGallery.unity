    prefab: {fileID: 7557991203433448611, guid: 22cc14e527e4109419ba68fe99f76003, type: 3}
  - id: STK-M04
    title: Heat-exchanger pack
    category: Module
    mount: side-saddle
    description: Radiator fins, insulated reservoir and pipework; no heat-resource
      system selected.
    prefab: {fileID: 1044567209054612419, guid: c6b60f910e950b24eaed1bf72b18dabf, type: 3}
  - id: STK-A01
    title: Glacis applique
    category: Armor
    mount: hull-front
    description: Replaceable bolted front armor shape; not a selected defense-stat
