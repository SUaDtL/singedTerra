    prefab: {fileID: 6836823326466116411, guid: 4b7b0c25fbadb864eae6e993a14d9861, type: 3}
  - id: STK-M03
    title: Survey radar
    category: Module
    mount: side-saddle
    description: A compact dish, console and mast. No targeting unlock or radar gameplay
