    prefab: {fileID: 2989176865257746171, guid: a785e4cb68df9384da99748082ad217a, type: 3}
  - id: STK-A02
    title: Spaced side skirts
    category: Armor
    mount: chassis
    description: Paired standoff rails and panels. Pair is one art assembly, not
      two gameplay slots.
    prefab: {fileID: 1976237897514343228, guid: 65e14735e5182834dbcc7cb9bd93aee8, type: 3}
  - id: STK-A03
    title: Turret cheek package
    category: Armor
    mount: turret-ring
    description: Two angled cheek arrays; a visible armor candidate rather than a
      rarity tier.
    prefab: {fileID: 3917565797288780483, guid: cd5d13d4f4b84de49b28b14e2e976556, type: 3}
  - id: STK-C01
    title: Crew stowage rack
    category: Cosmetic
    mount: hull-rear
    description: Bedroll, tool case and fuel cans; appearance only, no cargo bonus.
    prefab: {fileID: 139273372062098680, guid: 421902777cb294842ab446d0384a4434, type: 3}
  - id: STK-C02
    title: Identification pennant
