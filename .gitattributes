*.sh text eol=lf

# Asset recipes pin exact contract bytes across Windows and Linux.
.codearbiter/contracts/battle-console/** -text

# Native artifact parsing requires the generator's canonical LF bytes.
.codearbiter/specs/*.html text eol=lf
.codearbiter/plans/*.html text eol=lf

# Preserve the recorded performance artifact digests on every checkout.
docs/performance/artifacts/*.json text eol=lf

# Deterministic baseline artifacts retain their generator's bytes on checkout.
docs/balance/*.html text eol=lf
docs/balance/*.json text eol=lf

# Retained verifier hashes bind exact bytes on Windows and Linux checkouts.
shared/src/verified/retained/** text eol=lf
# Preserve the retained generator output's byte-bound trailing whitespace.
shared/src/verified/retained/cq1.mjs whitespace=-blank-at-eol

# Retain the Unity Web export's verified bytes across Windows and Linux checkouts.
client/public/last-stand/** -text
# Preserve the receipt-bound framework export's trailing whitespace bytes.
client/public/last-stand/Build/Web-20261005T005554Z-4472c0.framework.js whitespace=-blank-at-eol

# Portable source locks and sanitized receipts retain exact canonical LF bytes.
campaign-unity/docs/last-stand-web/*.json text eol=lf
client/public/last-stand/Build/*.framework.js whitespace=-blank-at-eol
# Preserve receipt-bound Unity metadata and the retained owner review records.
campaign-unity/Unity/Assets/Editor/LastStandBackgroundChecks.cs.meta whitespace=-blank-at-eol
# Unity serializes empty Android icon subkind values with a trailing space.
campaign-unity/Unity/ProjectSettings/ProjectSettings.asset whitespace=-blank-at-eol
campaign-unity/docs/last-stand-mechanics-shop/preview-review.md whitespace=-blank-at-eof
campaign-unity/docs/last-stand-mechanics-shop/validation.md whitespace=-blank-at-eof

# Collapse generated, immutable measurement rows in review; retain their exact
# bytes and keep the authored balance summary and validation inventory visible.
campaign-unity/docs/last-stand-combat-depth/combat-balance-baseline-report.json linguist-generated=true
campaign-unity/docs/last-stand-combat-depth/combat-balance-calibrated-report.json linguist-generated=true
campaign-unity/docs/last-stand-combat-depth/crowded-wave-baseline-report.json linguist-generated=true
campaign-unity/docs/last-stand-combat-depth/crowded-wave-calibrated-report.json linguist-generated=true
