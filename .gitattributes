*.sh text eol=lf

# Asset recipes pin exact contract bytes across Windows and Linux.
.codearbiter/contracts/battle-console/** -text

# Preserve the recorded performance artifact digests on every checkout.
docs/performance/artifacts/*.json text eol=lf

# Deterministic baseline artifacts retain their generator's bytes on checkout.
docs/balance/*.html text eol=lf
docs/balance/*.json text eol=lf

# Retained verifier hashes bind exact bytes on Windows and Linux checkouts.
shared/src/verified/retained/** text eol=lf
# Preserve the retained generator output's byte-bound trailing whitespace.
shared/src/verified/retained/cq1.mjs whitespace=-blank-at-eol
